{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".bkit/**",
      "docs/**",
      "PRD_Daily_Growth_Assistant_v1.1.md",
      "node_modules/**",
      ".claude/**",
      ".git/**"
    ],
    "rewrites": [
      { "source": "/", "destination": "/daily-growth.html" },
      { "source": "**", "destination": "/daily-growth.html" }
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
